  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://awecrsklxaeqxctfxirt.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "arena-mcp",
      "version": "0.1.0",
      "title": "Arena MCP"
    },
    "tools": [
      {
        "name": "list_matches",
        "title": "List matches",
        "description": "Return all matches currently tracked in the Arena app (live, finished, and in overtime).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "league": {
              "description": "Optional league filter, e.g. 'Brasileirão', 'NBA'.",
              "type": "string"
            },
            "status": {
              "description": "Optional status filter.",
              "type": "string",
              "enum": [
                "AO VIVO",
                "PRORROGAÇÃO",
                "ENC"
              ]
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
